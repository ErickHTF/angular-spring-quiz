@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Anfitrião (Host)" as Host
actor "Jogador (Player)" as Player
actor "Temporizador (Sistema)" as Timer

package "Fresh Quiz" {
  usecase "Gerenciar Quizzes e Perguntas" as UC_ManageQuiz
  usecase "Criar Sala de Jogo" as UC_CreateRoom
  usecase "Iniciar Partida" as UC_StartGame
  usecase "Avançar ou Pular Pergunta" as UC_NextSkip
  usecase "Reiniciar Jogo (Mesmo Grupo)" as UC_Restart
  usecase "Entrar na Sala" as UC_JoinRoom
  usecase "Responder Pergunta (com Tempo)" as UC_Answer
  usecase "Acompanhar Placar e Ranking" as UC_Scoreboard
  usecase "Revelar Resposta por Tempo Esgotado" as UC_RevealTimeout
}

Host --> UC_ManageQuiz
Host --> UC_CreateRoom
Host --> UC_StartGame
Host --> UC_NextSkip
Host --> UC_Restart
Host --> UC_Scoreboard

Player --> UC_JoinRoom
Player --> UC_Answer
Player --> UC_Scoreboard

Timer --> UC_RevealTimeout
@enduml
