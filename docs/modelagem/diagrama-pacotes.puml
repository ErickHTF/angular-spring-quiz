@startuml diagrama-pacotes
skinparam packageStyle folder
skinparam shadowing false
skinparam classAttributeIconSize 0

package "fonte-api (backend)" #C2C29E {
  package "controller" {
    class GameController <<RestController>>
    class QuizController <<RestController>>
  }
  package "game" {
    class GameService <<Service>>
    class GameRepository <<Repository>>
  }
  package "quiz" {
    class QuizService <<Service>>
    class QuizRepository <<Repository>>
  }
  package "model" {
    class Game <<Entity>>
  }
}

package "fonte-web (frontend)" #F06BC8 {
  package "pages" {
    class HomePage <<Component>>
    class HostGamePage <<Component>>
    class QuizListPage <<Component>>
    class QuizBuilderPage <<Component>>
  }
  package "core" {
    class GameApi <<Service>>
    class GameStateStore <<Service>>
  }
}

GameController ..> GameService
QuizController ..> QuizService
GameService ..> GameRepository
GameService ..> Game
GameRepository ..> Game
QuizService ..> QuizRepository

HostGamePage ..> GameApi
HostGamePage ..> GameStateStore
HomePage ..> GameApi
QuizListPage ..> GameApi
QuizBuilderPage ..> GameApi
GameApi ..> GameController : HTTP REST
GameApi ..> QuizController : HTTP REST
GameStateStore ..> GameController : SSE
@enduml
