@startuml casos-de-uso
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Jogador (Player)" as Jogador
actor "Anfitrião (Host)" as Anfitriao
actor "Temporizador (Sistema)" as Temporizador

rectangle "Fresh Quiz" {
  usecase "Entrar na Sala" as UC1
  usecase "Responder Pergunta" as UC2
  usecase "Sair da Sala" as UC3
  usecase "Gerenciar partida" as UC4
  usecase "Manter Quizzes" as UC5
  usecase "Revelar Resposta por\nTempo Esgotado" as UC6
}

Jogador --> UC1
Jogador --> UC2
Jogador --> UC3
Anfitriao --> UC4
Anfitriao --> UC5
Temporizador --> UC6

note right of UC4
  Criar sala, iniciar, pular pergunta,
  avançar, encerrar e jogar novamente.
end note

note right of UC5
  Criar, listar, editar e excluir quizzes
  e suas perguntas/alternativas.
end note
@enduml
